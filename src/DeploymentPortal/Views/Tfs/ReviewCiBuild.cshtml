@model DeploymentPortal.ViewModels.Tfs.TfsRunBuildViewModel
@{ ViewData["Title"] = "Review CI build"; }
<div class="page-heading"><div><div class="eyebrow">TFS</div><h1>Review CI Build</h1><p>Queue a new CI build from the latest checked-in source resolved when you clicked CI Build.</p></div></div>
@if (Model.Error is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
    <a class="btn btn-primary" asp-action="Index">Back to Pipelines</a>
}
else if (Model.Definition is { } definition)
{
    <section class="panel max-form">
        <div class="panel-heading"><h2>CI build confirmation</h2></div>
        <partial name="_RunDefinition" model="definition" />
        <form asp-action="ConfirmBuild" method="post" class="p-4" data-busy>
            <input type="hidden" name="confirmationToken" value="@Model.ConfirmationToken" />
            <p>Confirmation queues a real CI build. This review expires after 10 minutes and can be submitted once.</p>
            <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Confirm &amp; Run CI Build</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
        </form>
    </section>
}
