@model string
<svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
@switch (Model) {
case "terminal": <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m6 9 3 3-3 3m6 0h5"/> break;
case "container": <rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M8 5v14m8-14v14"/> break;
case "server": <rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 6.5h.01M7 17.5h.01M11 6.5h6M11 17.5h6"/> break;
case "grid": <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/> break;
case "rocket": <path d="M14 5c3-3 7-2 7-2s1 4-2 7l-7 7-5-5 7-7ZM7 12H3l3-5h6m0 10v4l5-3v-6M4 17l-1 4 4-1"/><circle cx="16" cy="8" r="1.5"/> break;
case "activity": <path d="M2 12h5l3-8 4 16 3-8h5"/> break;
case "clock": <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/> break;
case "settings": <path d="m9 3-1 3-3 1-2 5 2 5 3 1 1 3h6l1-3 3-1 2-5-2-5-3-1-1-3Z"/><circle cx="12" cy="12" r="3"/> break;
case "arrow": <path d="M5 12h14m-5-5 5 5-5 5"/> break;
case "plus": <path d="M12 5v14M5 12h14"/> break;
case "shield": <path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/> break;
default: <circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4h.01"/> break;
}
</svg>
