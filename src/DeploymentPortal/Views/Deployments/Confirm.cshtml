@model ConfirmDeploymentViewModel
@{ ViewData["Title"] = "Confirm deployment"; }
<div class="page-heading"><div><div class="eyebrow">FINAL REVIEW</div><h1>Ready to deploy?</h1><p>Review the release destination before confirming.</p></div></div>
<div class="stepper"><span>1 <b>Configure</b></span><i></i><span class="current">2 <b>Review & confirm</b></span><i></i><span>3 <b>Deployment result</b></span></div>
<section class="panel max-form"><div class="panel-heading"><h2>@Model.Form.ApplicationName</h2><span class="environment">@Model.Form.Environment</span></div><dl class="detail-grid"><dt>Server</dt><dd>@Model.Server.DisplayName (@Model.Server.HostNameOrIp)</dd><dt>Environment</dt><dd>@Model.Form.Environment</dd><dt>IIS site</dt><dd>@Model.Form.SiteName</dd><dt>Application</dt><dd>@Model.Form.ApplicationName</dd><dt>Action</dt><dd>@(Model.Form.PlanMode switch { "CreateSite" => "Create new site", "CreateApplication" => "Add application to existing site", _ => "Update existing application" })</dd><dt>Source</dt><dd class="font-monospace">@Model.Form.SourcePath</dd><dt>Target path</dt><dd class="font-monospace">@Model.Form.TargetPath</dd><dt>Application pool</dt><dd>@(Model.Form.AppPoolName ?? "Assigned or automatically created dedicated pool")</dd></dl><div class="form-body pt-0"><div class="alert alert-warning">@Model.Form.PlanMessage</div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirm-deployment">Review confirmation</button></div></section>
<div class="modal fade" id="confirm-deployment" data-auto-open tabindex="-1" aria-labelledby="confirm-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><div class="modal-header"><h2 id="confirm-title" class="modal-title fs-5">Confirm IIS deployment</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert @(Model.Form.PlanMode == "CreateSite" ? "alert-info" : "alert-warning")" role="status">@Model.Form.PlanMessage</div><dl class="detail-grid p-0"><dt>Server</dt><dd>@Model.Server.DisplayName (@Model.Server.HostNameOrIp)</dd><dt>Environment</dt><dd>@Model.Form.Environment</dd><dt>IIS site</dt><dd>@Model.Form.SiteName</dd><dt>Application</dt><dd>@Model.Form.ApplicationName</dd><dt>Action</dt><dd>@(Model.Form.PlanMode switch { "CreateSite" => "Create new site", "CreateApplication" => "Add application to existing site", _ => "Update existing application" })</dd><dt>Source</dt><dd class="font-monospace">@Model.Form.SourcePath</dd><dt>Target path</dt><dd class="font-monospace">@Model.Form.TargetPath</dd></dl><div class="soft-note">Confirmation expires in ten minutes. The deployment continues if you close the browser.</div></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal">Cancel</button><form asp-action="Create" method="post" data-busy>
@foreach (var entry in new Dictionary<string, string?> { ["ServerId"] = Model.Form.ServerId.ToString(), ["Environment"] = Model.Form.Environment, ["SiteName"] = Model.Form.SiteName, ["ApplicationName"] = Model.Form.ApplicationName, ["AppPoolName"] = Model.Form.AppPoolName, ["SourcePath"] = Model.Form.SourcePath, ["TargetPath"] = Model.Form.TargetPath, ["SitePort"] = Model.Form.SitePort.ToString(), ["SiteHostName"] = Model.Form.SiteHostName, ["ConfirmationToken"] = Model.Form.ConfirmationToken }) { <input type="hidden" name="@entry.Key" value="@entry.Value" /> }
<button class="btn btn-primary" type="submit">@(Model.Form.PlanMode == "CreateSite" ? "Confirm new deployment" : "Approve update & deploy")</button></form></div></div></div></div>
<noscript><p class="alert alert-info mt-3">Enable JavaScript to open the deployment confirmation dialog.</p></noscript>
