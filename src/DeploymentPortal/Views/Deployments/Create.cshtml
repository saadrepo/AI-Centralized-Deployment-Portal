@model DeploymentForm
@{ ViewData["Title"] = "IIS Deployments"; var servers = (List<Server>)ViewBag.Servers; }
<div class="page-heading"><div><div class="eyebrow">RELEASE MANAGEMENT</div><h1>Deploy an application</h1><p>A controlled release to your selected Windows server.</p></div><span class="environment">IIS / WinRM</span></div>
<div class="stepper"><span class="current">1 <b>Configure</b></span><i></i><span>2 <b>Review & confirm</b></span><i></i><span>3 <b>Deployment result</b></span></div>
<div class="row g-4"><div class="col-xl-8"><section class="panel"><div class="panel-heading"><h2>Deployment configuration</h2></div><form asp-action="Review" method="post" class="form-body" data-busy><input type="hidden" asp-for="PreparationId" /><div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (servers.Count == 0) { <div class="alert alert-info">Register a server first. <a asp-controller="Servers" asp-action="Create">Add server →</a></div> }
<h3 class="form-section-title">01 <span>Target environment</span></h3><div class="row g-4"><div class="col-md-6"><label asp-for="ServerId"></label><select asp-for="ServerId" class="form-select" id="deployment-server"><option value="0">Select a server</option>@foreach (var s in servers) { <option value="@s.Id" data-environment="@s.Environment">@s.DisplayName — @s.HostNameOrIp</option> }</select><span asp-validation-for="ServerId"></span></div><div class="col-md-6"><label asp-for="Environment"></label><select asp-for="Environment" class="form-select" id="deployment-environment">@foreach (var e in Environments.All) { <option>@e</option> }</select></div></div>
<h3 class="form-section-title mt-4">02 <span>IIS application</span></h3><div class="row g-4"><div class="col-md-6"><label asp-for="SiteName"></label><input asp-for="SiteName" class="form-control" placeholder="Internal Applications" /><span asp-validation-for="SiteName"></span></div><div class="col-md-6"><input type="hidden" asp-for="ApplicationName" /><label>Application address</label><div class="form-control">Site root (/)</div><div class="form-text">The application opens directly at the site address. No extra path is needed.</div></div><div class="col-12"><label asp-for="AppPoolName"></label><input asp-for="AppPoolName" class="form-control" placeholder="Leave blank to use the assigned pool or create a dedicated pool" /><span asp-validation-for="AppPoolName"></span></div></div>
<div class="row g-4 mt-1"><div class="col-md-6"><label asp-for="SitePort"></label><input asp-for="SitePort" class="form-control" /><span asp-validation-for="SitePort"></span></div><div class="col-md-6"><label asp-for="SiteHostName"></label><input asp-for="SiteHostName" class="form-control" placeholder="Leave blank for access by IP and port" /><span asp-validation-for="SiteHostName"></span></div><div class="col-12"><p class="form-text">Used only when creating a site. Existing site bindings are preserved. New sites use HTTP; DNS and firewall configuration remain under your control.</p></div></div>
<h3 class="form-section-title mt-4">03 <span>Application files</span></h3><div class="row g-4"><div class="col-12"><label asp-for="SourcePath"></label><input asp-for="SourcePath" class="form-control font-monospace" placeholder="Enter your published package folder" /><span asp-validation-for="SourcePath"></span><div class="form-text">Published folder containing web.config, already staged on the remote server.</div></div><div class="col-12"><label asp-for="TargetPath"></label><input asp-for="TargetPath" class="form-control font-monospace" placeholder="Enter your application destination folder" /><span asp-validation-for="TargetPath"></span><div class="form-text">Choose your own folder. For an existing application, use its current IIS physical path. A missing target folder will be created.</div></div></div><div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary" disabled="@(servers.Count == 0)">Review deployment</button></div></form></section></div>
<div class="col-xl-4"><section class="help-panel"><span class="help-icon">↗</span><h2>One release. Every step covered.</h2><ol class="workflow"><li>Validate server & package</li><li>Detect new or existing IIS application</li><li>Stop the dedicated app pool</li><li>Back up existing files</li><li>Create or update & restart</li><li>Verify IIS state</li></ol><div class="soft-note">If file replacement fails, the workflow attempts to restore the backup. Backups are retained for recovery.</div><p class="mt-3 mb-0">You’ll review the destination and confirm before anything runs.</p></section></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
