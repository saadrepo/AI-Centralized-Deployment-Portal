@model IReadOnlyList<DeploymentPortal.Services.IisSite>
@{ ViewData["Title"] = "IIS Sites"; var servers = (IReadOnlyList<Server>)ViewBag.Servers; int? selected = ViewBag.ServerId; }
<div class="page-heading"><div><h1>IIS Sites</h1><p>Current sites from your selected server. Deployment history is retained separately.</p></div></div>
<section class="panel"><div class="form-body">
<form method="get" asp-action="Index" class="d-flex gap-3 align-items-end">
<div class="flex-grow-1"><label for="serverId">Server</label><select id="serverId" name="serverId" class="form-select" required><option value="">Select a server</option>
@foreach (var server in servers) { <option value="@server.Id" selected="@(selected == server.Id)">@server.DisplayName (@server.HostNameOrIp)</option> }
</select></div><button class="btn btn-primary" type="submit">Load / refresh sites</button></form>
@if (ViewData["InventoryError"] is string error) { <div class="alert alert-danger mt-3">@error</div> }
else if (selected.HasValue) {
    if (Model.Count == 0) { <p class="mt-3">No IIS sites currently exist on this server.</p> }
    else { <div class="table-responsive mt-4"><table class="table"><thead><tr><th>Site</th><th>State</th><th>Bindings</th><th>Action</th></tr></thead><tbody>
    @foreach (var site in Model) { <tr><td>@site.Name</td><td>@site.State</td><td>@site.Bindings</td><td><a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-serverId="@selected" asp-route-siteName="@site.Name">Delete site</a></td></tr> }
    </tbody></table></div> }
}
</div></section>
