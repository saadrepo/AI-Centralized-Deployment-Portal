@model DockerDeploymentReview
@{ ViewData["Title"] = "Review Docker deployment"; }
<div class="page-heading"><div><div class="eyebrow">FINAL REVIEW</div><h1>Ready to deploy?</h1><p>Check the target, image and container settings.</p></div></div>
<div class="stepper"><span>1 <b>Configure</b></span><i></i><span class="current">2 <b>Review &amp; confirm</b></span><i></i><span>3 <b>Result</b></span></div>
<section class="panel max-form"><div class="panel-heading"><h2>@Model.Form.ContainerName</h2><span class="environment">@Model.Form.Context</span></div><dl class="detail-grid"><dt>Docker server</dt><dd>@Model.Form.Context</dd><dt>Image</dt><dd>@Model.Form.Image</dd><dt>Image ID</dt><dd class="font-monospace">@Model.ImageId</dd><dt>Action</dt><dd>@(Model.ExistingContainerId is null ? "Create new container" : "Replace existing container and retain previous version")</dd><dt>Port mapping</dt><dd>@Model.Form.HostPort → @Model.Form.ContainerPort</dd><dt>Environment</dt><dd><pre class="mb-0">@(Model.Form.EnvironmentVariables ?? "None")</pre></dd><dt>Storage</dt><dd>@(Model.Form.VolumeName is null ? "None" : $"{Model.Form.VolumeName} → {Model.Form.MountPath}")</dd></dl>
<div class="form-body pt-0"><div class="alert alert-warning">@if (Model.ExistingContainerId is null) { <text>A new container will be created.</text> } else { <text>The current container will be stopped and retained for rollback. The new container will use this name and port.</text> }</div>
<form asp-action="Deploy" method="post" data-busy><input type="hidden" name="Context" value="@Model.Form.Context" /><input type="hidden" name="Image" value="@Model.Form.Image" /><input type="hidden" name="ContainerName" value="@Model.Form.ContainerName" /><input type="hidden" name="HostPort" value="@Model.Form.HostPort" /><input type="hidden" name="ContainerPort" value="@Model.Form.ContainerPort" /><input type="hidden" name="EnvironmentVariables" value="@Model.Form.EnvironmentVariables" /><input type="hidden" name="VolumeName" value="@Model.Form.VolumeName" /><input type="hidden" name="MountPath" value="@Model.Form.MountPath" /><input type="hidden" name="ConfirmationToken" value="@Model.Form.ConfirmationToken" /><a class="btn btn-light" asp-action="Create" asp-route-context="@Model.Form.Context">Edit</a> <button class="btn btn-primary" type="submit">Confirm Docker deployment</button></form></div></section>
