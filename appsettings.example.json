{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=DeploymentPortal;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Automation": {
    "BackupRoot": "C:\\DeploymentBackups",
    "ConnectionTimeoutSeconds": 30,
    "DeploymentTimeoutSeconds": 900
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
