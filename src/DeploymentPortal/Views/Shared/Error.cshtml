@model ErrorViewModel
@{ ViewData["Title"] = "Unable to complete request"; }
<section class="panel max-form"><div class="empty-state"><span>!</span><h1>We couldn’t complete this request</h1><p>Check SQL Server availability and confirm that database migrations have been applied, then try again.</p><p>No sensitive error details are displayed.</p><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return to dashboard</a>@if (Model.ShowRequestId) { <small class="d-block mt-4">Reference: @Model.RequestId</small> }</div></section>
