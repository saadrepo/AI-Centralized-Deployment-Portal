@model DockerDeploymentForm
@{ ViewData["Title"] = "Deploy Docker image"; var dashboard = (DockerDashboardViewModel)ViewBag.Dashboard; }
<div class="page-heading"><div><a class="back-link" asp-action="Index" asp-route-context="@Model.Context">← Docker Deployments</a><h1>Deploy Docker image</h1><p>Select a server image and configure the container.</p></div></div>
<div class="stepper"><span class="current">1 <b>Configure</b></span><i></i><span>2 <b>Review &amp; confirm</b></span><i></i><span>3 <b>Result</b></span></div>
<section class="panel max-form"><div class="panel-heading"><h2>Container configuration</h2></div><form asp-action="Review" method="post" class="form-body" data-busy><div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (dashboard.Error is not null) { <div class="alert alert-warning">@dashboard.Error</div> }
<div class="mb-4"><label asp-for="Context"></label><select asp-for="Context" class="form-select" id="docker-deploy-context" onchange="window.location.href='@Url.Action("Create")?context='+encodeURIComponent(this.value)">@foreach (var item in dashboard.Contexts) { <option value="@item.Name">@item.Name — @item.Description</option> }</select><span asp-validation-for="Context"></span><div class="form-text">Changing server reloads its images and clears this form.</div></div>
<div class="mb-4"><label asp-for="Image"></label><select asp-for="Image" class="form-select"><option value="">Select an image</option>@foreach (var image in dashboard.Images) { <option value="@image.Name">@image.Name (@image.Size)</option> }</select><span asp-validation-for="Image"></span></div>
<div class="mb-4"><label asp-for="ContainerName"></label><input asp-for="ContainerName" class="form-control" placeholder="my-app" /><span asp-validation-for="ContainerName"></span><div class="form-text">If this name already exists, its container is preserved for rollback when the new version is deployed.</div></div>
<div class="row g-4 mb-4"><div class="col-md-6"><label asp-for="HostPort"></label><input asp-for="HostPort" class="form-control" /><span asp-validation-for="HostPort"></span></div><div class="col-md-6"><label asp-for="ContainerPort"></label><input asp-for="ContainerPort" class="form-control" /><span asp-validation-for="ContainerPort"></span></div></div>
<div class="mb-4"><label asp-for="EnvironmentVariables"></label><textarea asp-for="EnvironmentVariables" class="form-control font-monospace" rows="5" placeholder="ASPNETCORE_ENVIRONMENT=Production"></textarea><span asp-validation-for="EnvironmentVariables"></span><div class="form-text">These values are stored in Docker container configuration and may be visible to Docker administrators. Do not enter secrets.</div></div>
<div class="row g-4"><div class="col-md-6"><label asp-for="VolumeName"></label><input asp-for="VolumeName" class="form-control" placeholder="my-app-data" /><span asp-validation-for="VolumeName"></span></div><div class="col-md-6"><label asp-for="MountPath"></label><input asp-for="MountPath" class="form-control font-monospace" placeholder="/app/data" /><span asp-validation-for="MountPath"></span></div></div><div class="form-text mt-2">Optional named Docker volume. Volumes are retained when containers are deleted or rolled back.</div>
<div class="form-actions"><a class="btn btn-light" asp-action="Index" asp-route-context="@Model.Context">Cancel</a><button type="submit" class="btn btn-primary" disabled="@(dashboard.Images.Count == 0)">Review deployment</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
