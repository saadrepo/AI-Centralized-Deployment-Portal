@model List<Server>
@{ ViewData["Title"] = "Servers"; }
<partial name="_InfrastructureTabs" />
<div class="page-heading"><div><div class="eyebrow">INFRASTRUCTURE</div><h1>Servers <span class="count-pill">@Model.Count</span></h1><p>Manage Windows endpoints and verify remote connectivity.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add server</a></div>
<section class="panel"><div class="panel-heading"><h2>Server inventory</h2><input class="form-control table-search" data-table-filter="#servers-table" aria-label="Filter servers" placeholder="Search servers…" /></div><div class="table-responsive"><table id="servers-table" class="table align-middle"><thead><tr><th>Server name</th><th>Operating system</th><th>RAM (total)</th><th>Environment</th><th>Connection</th><th>Status</th><th>Last checked (UTC)</th><th>Actions</th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td><strong>@s.DisplayName</strong><small class="cell-subtitle">@s.HostNameOrIp</small></td><td>@s.OperatingSystem</td><td><partial name="_ServerMemory" model="s" /></td><td><span class="environment">@s.Environment</span></td><td>@s.ConnectionType<small class="cell-subtitle">@(s.UseSsl ? "HTTPS" : "HTTP") · @s.WinRmPort</small></td><td><partial name="_Status" model="s.LastConnectionStatus.ToString()" /></td><td>@(s.LastCheckedAt?.ToString("dd MMM yyyy HH:mm") ?? "Never checked")</td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@s.Id">Details</a><a asp-action="Edit" asp-route-id="@s.Id">Edit</a><form asp-action="TestConnection" asp-route-id="@s.Id" method="post" data-busy><button type="submit" class="btn-link">Test connection</button></form><a asp-controller="Deployments" asp-action="Create" asp-route-serverId="@s.Id">Deploy ↗</a></div></td></tr> }
</tbody></table></div>
@if (Model.Count == 0) { <div class="empty-state"><span>▤</span><h3>No servers registered</h3><p>Add your first Windows server to connect and deploy.</p><a class="btn btn-primary" asp-action="Create">Add server</a></div> }
</section>
