@model Deployment
@{ ViewData["Title"] = "Deployment result"; var pending = Model.Status is DeploymentStatus.Running or DeploymentStatus.Queued; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Deployment history</a><h1>@Model.ApplicationName</h1><p>Release to @Model.Server.DisplayName · @Model.Environment</p></div><partial name="_Status" model="Model.Status.ToString()" /></div>
<div class="result-banner @(Model.Status == DeploymentStatus.Failed ? "result-failed" : "")" role="status" data-refresh="@(pending ? "true" : "false")">@if (pending) { <div class="spinner-border text-primary" aria-hidden="true"></div> } else { <div class="result-symbol">@(Model.Status == DeploymentStatus.Successful ? "✓" : "!")</div> }<div><h2>@(pending ? "Deployment " + Model.Status.ToString().ToLowerInvariant() : "Deployment " + Model.Status.ToString().ToLowerInvariant())</h2><p>@Model.ResultMessage</p>@if (pending) { <small>This page refreshes every five seconds. You can safely leave and return.</small> }</div></div>
<section class="panel"><div class="panel-heading"><h2>Release details</h2><a asp-action="Create" asp-route-serverId="@Model.ServerId">New deployment →</a></div><dl class="detail-grid"><dt>Deployment ID</dt><dd class="font-monospace">@Model.Id</dd><dt>Application</dt><dd>@Model.ApplicationName</dd><dt>Server</dt><dd><a asp-controller="Servers" asp-action="Details" asp-route-id="@Model.ServerId">@Model.Server.DisplayName</a></dd><dt>Environment</dt><dd>@Model.Environment</dd><dt>IIS site</dt><dd>@Model.SiteName</dd><dt>Deployment action</dt><dd>@(Model.DeploymentMode switch { "CreateSite" => "Create new site", "CreateApplication" => "Add application", "Update" => "Update application", _ => "Legacy deployment" })</dd><dt>Application pool</dt><dd>@(Model.AppPoolName ?? "Assigned IIS pool")</dd><dt>Started at</dt><dd>@Model.StartedAt.ToString("dd MMM yyyy HH:mm:ss") UTC</dd><dt>Completed at</dt><dd>@(Model.CompletedAt?.ToString("dd MMM yyyy HH:mm:ss") ?? "—")</dd><dt>Duration</dt><dd>@Model.Duration</dd><dt>Source</dt><dd class="font-monospace">@Model.SourcePath</dd><dt>Target path</dt><dd class="font-monospace">@Model.TargetPath</dd><dt>Reserved backup path</dt><dd class="font-monospace">@Model.BackupPath<small class="cell-subtitle">A backup exists only if the backup step completed. Verify it before manual recovery.</small></dd></dl></section>

@if (!pending) { <div class="mt-4"><a class="btn btn-outline-danger" asp-controller="Sites" asp-action="Delete" asp-route-id="@Model.Id">Delete IIS site</a></div> }
