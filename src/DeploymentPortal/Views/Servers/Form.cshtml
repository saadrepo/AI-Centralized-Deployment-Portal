@model ServerForm
@{ ViewData["Title"] = Model.Id == 0 ? "Add server" : "Edit server"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Servers</a><h1>@ViewData["Title"]</h1><p>Configure a Windows endpoint for PowerShell Remoting.</p></div></div>
<div class="row g-4"><div class="col-xl-8"><section class="panel"><div class="panel-heading"><h2>Connection details</h2><span class="environment">Windows / WinRM</span></div>
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="form-body" data-busy>
    <input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (ViewData["ConnectionSuccess"] is string ok) { <div class="alert alert-success">@ok</div> }
    @if (ViewData["ConnectionError"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="row g-4"><div class="col-md-6"><label asp-for="DisplayName"></label><input asp-for="DisplayName" class="form-control" placeholder="e.g. Web server 01" /><span asp-validation-for="DisplayName"></span></div><div class="col-md-6"><label asp-for="HostNameOrIp"></label><input asp-for="HostNameOrIp" class="form-control" placeholder="web-01.internal" /><span asp-validation-for="HostNameOrIp"></span></div>
    <div class="col-md-6"><label asp-for="Environment"></label><select asp-for="Environment" class="form-select">@foreach (var e in Environments.All) { <option>@e</option> }</select></div><div class="col-md-6"><label for="connection-type">Connection type</label><input id="connection-type" class="form-control" value="Windows (WinRM)" readonly /></div>
    <div class="col-md-6"><label asp-for="WinRmPort"></label><input asp-for="WinRmPort" class="form-control" /><span asp-validation-for="WinRmPort"></span></div><div class="col-md-6 d-flex align-items-center"><div class="form-check form-switch mt-4"><input asp-for="UseSsl" class="form-check-input" /><label asp-for="UseSsl" class="form-check-label"></label></div></div>
    <div class="col-12"><label asp-for="Username"></label><input asp-for="Username" class="form-control" placeholder="SERVERNAME\deploy-user" autocomplete="off" /><span asp-validation-for="Username"></span><p class="form-text">Credentials must be configured on the dashboard host before testing.</p></div></div>
    <div class="form-actions"><button type="submit" class="btn btn-outline-primary" formaction="@Url.Action("TestDraft")">Test connection</button><div><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save server</button></div></div>
</form></section></div><div class="col-xl-4"><section class="help-panel"><span class="help-icon">◇</span><h2>A secure connection starts here</h2><p>Use a hostname matching the server’s WinRM HTTPS certificate. The default HTTPS port is 5986.</p><hr /><h3>Development credentials</h3><p>Passwords are resolved by the credential provider and never stored in the server database.</p><p>Configure a host-specific password with .NET user secrets. This provider is available only in Development.</p><a asp-controller="Home" asp-action="Settings">View configuration →</a></section></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
