@model Server
@{ ViewData["Title"] = "Server details"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Servers</a><h1>@Model.DisplayName</h1><p>@Model.HostNameOrIp <span class="mx-2">/</span> @Model.Environment</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit server</a><a class="btn btn-primary" asp-controller="Deployments" asp-action="Create" asp-route-serverId="@Model.Id">Deploy application ↗</a></div></div>
<div class="row g-4"><div class="col-lg-8"><section class="panel"><div class="panel-heading"><h2>Server configuration</h2><partial name="_Status" model="Model.LastConnectionStatus.ToString()" /></div><dl class="detail-grid"><dt>Host / IP</dt><dd>@Model.HostNameOrIp</dd><dt>Environment</dt><dd>@Model.Environment</dd><dt>Operating system</dt><dd>@Model.OperatingSystem</dd><dt>RAM (total)</dt><dd><partial name="_ServerMemory" model="Model" /></dd><dt>Connection</dt><dd>@Model.ConnectionType · @(Model.UseSsl ? "HTTPS" : "HTTP") · @Model.WinRmPort</dd><dt>Username</dt><dd>@Model.Username</dd><dt>Created</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm:ss") UTC</dd><dt>Last checked</dt><dd>@(Model.LastCheckedAt?.ToString("dd MMM yyyy HH:mm:ss") ?? "Never checked")</dd></dl></section></div><div class="col-lg-4"><section class="help-panel"><h2>Verify connectivity</h2><p>Run a controlled WinRM connection test and retrieve the server name and operating system.</p><form asp-action="TestConnection" asp-route-id="@Model.Id" method="post" data-busy><button class="btn btn-primary w-100" type="submit">Test connection</button></form></section><div class="mt-4"><button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#delete-server">Remove server</button><p class="form-text">Servers with deployment history are retained.</p></div></div></div>
<div class="modal fade" id="delete-server" tabindex="-1" aria-labelledby="delete-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="delete-title">Remove server?</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">Remove @Model.DisplayName from the inventory?</div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal">Cancel</button><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="btn btn-danger" type="submit">Remove server</button></form></div></div></div></div>
