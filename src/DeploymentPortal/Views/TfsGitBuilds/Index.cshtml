@model DeploymentPortal.ViewModels.Tfs.TfsGitCiBuildsPageViewModel
@{
    ViewData["Title"] = "TFS Git CI Builds";
    string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
<form method="get" class="mb-4">
    <input type="hidden" name="applicationKey" value="@Model.ApplicationKey" />
    <label for="source-provider" class="form-label">Source Provider</label>
    <select id="source-provider" name="provider" class="form-select mb-2">
        <option value="Tfs2018" selected="@(Model.Provider == "Tfs2018")">TFS 2018</option>
        <option value="GitHub" selected="@(Model.Provider == "GitHub")">GitHub</option>
        <option value="AzureDevOps" selected="@(Model.Provider == "AzureDevOps")">Azure DevOps Services</option>
    </select>
    <button type="submit" class="btn btn-outline-primary">Load provider</button>
</form>
@if (Model.Provider != "Tfs2018") {
    <partial name="_CloudExplorer" model="Model" />
} else {
<div class="page-heading">
    <div><div class="eyebrow">TFS Git</div><h1>CI Builds <span class="badge bg-secondary fs-6">Read-only</span></h1><p>@(Model.ApplicationKey == "Portal" ? "deployment-portal-poc-CI" : Model.ApplicationKey) · Dev · Latest 25 builds</p></div>
    <a class="btn btn-outline-primary" asp-action="Index" asp-route-applicationKey="@Model.ApplicationKey">Refresh builds</a>
</div>
<form method="get" class="mb-3">
    <label for="ci-application" class="form-label">Application</label>
    <select id="ci-application" name="applicationKey" class="form-select mb-2">
    @foreach (var app in Model.Applications) { <option value="@app.Key" selected="@(app.Key == Model.ApplicationKey)">@app.DisplayName (definition @app.TfsGitCiDefinitionId)</option> }
    </select><button type="submit" class="btn btn-outline-primary">Load builds</button>
</form>
@if (Model.Error is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
else if (Model.Builds.Count == 0)
{
    <div class="alert alert-secondary" role="status">No CI builds found for Dev.</div>
}
else
{
    <section class="panel">
        <div class="panel-heading"><h2>Recent builds</h2><span class="badge bg-secondary">@Model.Builds.Count shown</span></div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Build number</th><th scope="col">Branch</th><th scope="col">Commit</th><th scope="col">Status</th><th scope="col">Result</th><th scope="col">Artifacts</th></tr></thead>
                <tbody>
                @foreach (var build in Model.Builds)
                {
                    <tr>
                        <td><strong>@Display(build.BuildNumber)</strong></td>
                        <td>@Display(build.BranchName)</td>
                        <td class="text-break"><code>@Display(build.SourceVersion)</code></td>
                        <td><span class="badge bg-secondary">@Display(build.Status)</span></td>
                        <td>@(string.IsNullOrWhiteSpace(build.Result) ? "Not available yet" : build.Result)</td>
                        <td><a class="btn btn-outline-primary btn-sm" asp-action="Artifacts" asp-route-id="@build.Id" asp-route-applicationKey="@Model.ApplicationKey">View artifacts</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
}
@section Scripts {
    @if (Model.Provider != "Tfs2018") { <script src="~/js/cloud-build-explorer.js" asp-append-version="true"></script> }
}
